# ---------------------------------------------------------------------------
# Visionary backend configuration. Copy to .env and fill in.
# Secrets live ONLY here (server-side). Never expose them to the frontend.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://visionary:visionary@localhost:5432/visionary
REDIS_URL=redis://localhost:6379/0

# --- Video analyzer ---------------------------------------------------------
# auto   -> agent when GEMINI_API_KEY is set and VISION_ENABLED, gemini if only the key, else mock
# agent  -> tool-calling agent over the local vision engine, escalating to Gemini video when needed
# gemini -> every question goes to Gemini with the video (no local vision)
# mock   -> deterministic development analyzer, no external calls
VIDEO_ANALYZER_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=180
# Frames per second Gemini samples from the video (blank = Gemini default, 1 fps)
GEMINI_VIDEO_FPS=

# --- Local vision engine (see docs/VISION_BENCHMARK.md) -------------------
VISION_ENABLED=true
VISION_DETECTOR=yolo
# blank = default weights for the detector (yolo26s.pt / rtdetr-l.pt), downloaded on first use
VISION_WEIGHTS=
VISION_TRACKER=bytetrack
VISION_DEVICE=auto
VISION_SAMPLE_FPS=10
VISION_CONFIDENCE=0.25
VISION_WEIGHTS_DIR=./models
# Agent LLM (blank = GEMINI_MODEL)
AGENT_MODEL=
AGENT_MAX_STEPS=6

# --- Video sources / URL safety --------------------------------------------
# Comma-separated domain allowlist. Empty = any public host (private/internal IPs are always blocked).
VIDEO_URL_ALLOWED_DOMAINS=
VIDEO_URL_ALLOW_HTTP=false
VIDEO_MAX_DOWNLOAD_MB=500
# Uploaded video files, stored under UPLOAD_DIR and deleted with their source.
ENABLE_VIDEO_UPLOADS=true
VIDEO_MAX_UPLOAD_MB=500
UPLOAD_DIR=./uploads
# Local files (development only). Paths must live under LOCAL_VIDEO_DIR.
ENABLE_LOCAL_VIDEO_SOURCES=false
LOCAL_VIDEO_DIR=./sample_videos
VIDEO_WORK_DIR=./.video_work

# --- Voice ------------------------------------------------------------------
# mock | gemini | http
STT_PROVIDER=mock
# mock | http
TTS_PROVIDER=mock
# Generic HTTP contract for self-hosted Kinyarwanda models (see docs/VOICE.md)
STT_HTTP_URL=
STT_HTTP_API_KEY=
TTS_HTTP_URL=
TTS_HTTP_API_KEY=
TTS_VOICE=

DEFAULT_LANGUAGE=rw
ASK_RATE_LIMIT_PER_MINUTE=20
# Store raw provider responses on analysis_requests (debugging only; may contain video descriptions)
STORE_RAW_PROVIDER_RESPONSES=false
