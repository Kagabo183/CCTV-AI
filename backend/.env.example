# ---------------------------------------------------------------------------
# Visionary backend configuration. Copy to .env and fill in.
# Secrets live ONLY here (server-side). Never expose them to the frontend.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_TTL_MINUTES=720
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://visionary:visionary@localhost:5432/visionary
REDIS_URL=redis://localhost:6379/0

# --- Video analyzer ---------------------------------------------------------
# auto   -> agent when GEMINI_API_KEY is set and VISION_ENABLED, gemini if only the key, else mock
# agent  -> tool-calling agent over the local vision engine, escalating to Gemini video when needed
# gemini -> every question goes to Gemini with the video (no local vision)
# mock   -> deterministic development analyzer, no external calls
VIDEO_ANALYZER_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=180
# Frames per second Gemini samples from the video (blank = Gemini default, 1 fps)
GEMINI_VIDEO_FPS=

# --- Local vision engine (see docs/VISION_BENCHMARK.md) -------------------
VISION_ENABLED=true
# yolo = YOLO26s COCO (80 classes) | yolo_o365 = YOLO26s Objects365 (365 classes) | rtdetr = RT-DETR-L COCO
VISION_DETECTOR=yolo
# Optional class restriction, e.g. person,car,truck. Empty = all classes the model knows.
VISION_CLASSES=
# Tracks below this mean confidence (or with an unstable class) are reported as "unknown".
VISION_CONFIRM_CONFIDENCE=0.5
# blank = default weights for the detector (yolo26s.pt / rtdetr-l.pt), downloaded on first use
VISION_WEIGHTS=
VISION_TRACKER=bytetrack
VISION_DEVICE=auto
VISION_SAMPLE_FPS=10
VISION_CONFIDENCE=0.25
# Small / distant objects (docs/SMALL_OBJECT_BENCHMARK.md). Full-frame size, then overlapping tiles merged in.
VISION_IMAGE_SIZE=1280
VISION_TILING=on
# 0 = auto (45% of the frame's short side). Tiles are run at VISION_TILE_IMAGE_SIZE, so small tiles are upscaled.
VISION_TILE_SIZE=0
VISION_TILE_OVERLAP=0.25
VISION_TILE_IMAGE_SIZE=640
VISION_TILE_FULL_FRAME=true
# Classes taken from tiles; other classes come from the full-frame pass only (tiles hallucinate rare classes).
VISION_TILE_CLASSES=person,bicycle,car,motorcycle,bus,truck
VISION_WEIGHTS_DIR=./models
# Agent LLM: gemini | local (OpenAI-compatible server such as Ollama running Qwen3; no Gemini cost)
AGENT_LLM=gemini
# local: defaults to LOCAL_VLM_URL / LOCAL_VLM_MODEL
AGENT_LOCAL_URL=
AGENT_LOCAL_MODEL=
# "none" = faster replies, less careful reasoning
AGENT_LOCAL_REASONING=
# Local agent works in English; NLLB-200 translates Kinyarwanda questions in and answers out (local, free).
TRANSLATION_PROVIDER=nllb
NLLB_MODEL=facebook/nllb-200-distilled-1.3B
# Gemini agent model (blank = GEMINI_MODEL)
AGENT_MODEL=
AGENT_MAX_STEPS=6

# --- Open-ended video understanding (vision-language models) --------------
# Tried in order; later ones are fallbacks (e.g. when Gemini's quota is used up).
VIDEO_UNDERSTANDING_PROVIDERS=gemini,local_vlm
# Local VLM via an OpenAI-compatible server (Ollama: http://127.0.0.1:11434/v1, LM Studio: http://127.0.0.1:1234/v1)
LOCAL_VLM_URL=http://127.0.0.1:11434/v1
LOCAL_VLM_MODEL=
TOGETHER_API_KEY=
TOGETHER_VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
UNDERSTANDING_FRAMES=6

# --- Video sources / URL safety --------------------------------------------
# Comma-separated domain allowlist. Empty = any public host (private/internal IPs are always blocked).
VIDEO_URL_ALLOWED_DOMAINS=
VIDEO_URL_ALLOW_HTTP=false
VIDEO_MAX_DOWNLOAD_MB=500
# Private networks where your own cameras/NVRs live (CIDR, comma-separated), e.g. 192.168.1.0/24.
# Everything else private (other LAN hosts, localhost, cloud metadata) stays blocked.
CAMERA_PRIVATE_NETWORKS=
# Imported links are converted to H.264 MP4 and stored like uploads.
VIDEO_IMPORT_MAX_SECONDS=1800
VIDEO_IMPORT_MAX_HEIGHT=1080
LIVE_CLIP_SECONDS=60
# Uploaded video files, stored under UPLOAD_DIR and deleted with their source.
ENABLE_VIDEO_UPLOADS=true
VIDEO_MAX_UPLOAD_MB=500
UPLOAD_DIR=./uploads
# Local files (development only). Paths must live under LOCAL_VIDEO_DIR.
ENABLE_LOCAL_VIDEO_SOURCES=false
LOCAL_VIDEO_DIR=./sample_videos
VIDEO_WORK_DIR=./.video_work

# YouTube sometimes blocks automated access ("confirm you're not a bot"). Export cookies from a
# signed-in browser (e.g. the "Get cookies.txt LOCALLY" extension) and point to the file. Keep it private.
YTDLP_COOKIES_FILE=

# --- Voice ------------------------------------------------------------------
# mock | gemini | http | mms (local Kinyarwanda/English with Meta MMS, no cloud cost)
STT_PROVIDER=mock
# mock | http
TTS_PROVIDER=mock
# Generic HTTP contract for self-hosted Kinyarwanda models (see docs/VOICE.md)
STT_HTTP_URL=
STT_HTTP_API_KEY=
TTS_HTTP_URL=
TTS_HTTP_API_KEY=
TTS_VOICE=

DEFAULT_LANGUAGE=rw
ASK_RATE_LIMIT_PER_MINUTE=20
# Store raw provider responses on analysis_requests (debugging only; may contain video descriptions)
STORE_RAW_PROVIDER_RESPONSES=false
